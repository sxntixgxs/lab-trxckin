# =============================================================================
# MCP server (apps/mcp-server/.env) — read-only access to Lab Trxckin data.
# Copy to .env for local runs; MCP clients (Claude Desktop, Claude Code) can pass the same
# variables in their server config instead. Placeholders only — never commit real values.
# =============================================================================

# Convex deployment URL (same as NEXT_PUBLIC_CONVEX_URL in apps/frontend/.env.local).
LAB_CONVEX_URL=https://your-deployment.convex.cloud

# Must match MCP_READ_SECRET in the Convex deployment (npx convex env set MCP_READ_SECRET ...).
# Which companies it can read is decided there, by MCP_EMPRESAS, not here.
LAB_MCP_SECRET=REPLACE_ME

# Optional: NestJS API for search_suppliers. Without it the tool is not registered.
# The key must match MCP_READ_KEY in apps/backend/.env (scope: MCP_EMPRESAS there).
LAB_API_URL=http://localhost:8000/api/v1
LAB_MCP_API_KEY=
