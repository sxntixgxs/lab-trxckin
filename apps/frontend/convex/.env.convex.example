# =============================================================================
# Convex deployment environment (reference only — Convex does NOT read this file)
# Set each value on the deployment, from apps/frontend:
#   npx convex env set NAME "value"          # dev deployment
#   npx convex env set NAME "value" --prod   # production deployment
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Auth --------------------------------------------------------------------
# Same WorkOS client id as the Next app (used by convex/auth.config.ts to verify JWTs).
WORKOS_CLIENT_ID=client_REPLACE_ME
# Must be IDENTICAL to CONVEX_SERVER_SECRET in apps/frontend/.env.local.
CONVEX_SERVER_SECRET=REPLACE_ME_CONVEX_SERVER_SECRET

# --- Calls back to Next.js (email notifications) -----------------------------
# Public URL of the Next app. Must be reachable from Convex's cloud
# (use a tunnel or a deployed URL; localhost only works with a local backend).
FRONTEND_URL=http://localhost:3000
# Must match the Next.js values.
NOTIFICATIONS_INTERNAL_KEY=REPLACE_ME_NOTIFICATIONS_INTERNAL_KEY
FACTURACION_SLA_DIGEST_SECRET=REPLACE_ME_FACTURACION_SLA_DIGEST_SECRET
# "true" builds the daily SLA digest without sending it.
FACTURACION_SLA_DIGEST_DRY_RUN=false

# --- Calls to NestJS (supplier upsert on invoice ingest) ---------------------
# Must be reachable from Convex's cloud; unset/unreachable -> call is skipped.
BACKEND_URL=http://localhost:8000
# Must match NEST_INTERNAL_KEY in apps/backend/.env.
NEST_INTERNAL_KEY=REPLACE_ME_NEST_INTERNAL_KEY

# --- Background jobs ---------------------------------------------------------
# Crons (mailbox sync, reprocessing, SLA digest, reconciliation) are always
# registered but exit immediately unless this is "true". Usually prod only.
ENABLE_BACKGROUND_JOBS=false

# --- Defaults ----------------------------------------------------------------
# Placeholder email for actors/owners with no email on record.
DEFAULT_CONTACT_EMAIL=no-email@example.com
# Comma-separated recipients of mailbox-ingest (Graph sync) alerts.
FACTURACION_GRAPH_MAILBOXES=ops@example.com,admin@example.com

# --- Microsoft Graph (optional; see docs/billing-azure-setup.md) -------------
# Default tenant (companies 1, 3, 4)
MS_TENANT_ID=REPLACE_ME_AZURE_TENANT_ID
MS_CLIENT_ID=REPLACE_ME_AZURE_CLIENT_ID
MS_CLIENT_SECRET=REPLACE_ME_AZURE_CLIENT_SECRET
# Secondary tenant (company 2)
MS_SECONDARY_TENANT_ID=REPLACE_ME_SECONDARY_AZURE_TENANT_ID
MS_SECONDARY_CLIENT_ID=REPLACE_ME_SECONDARY_AZURE_CLIENT_ID
MS_SECONDARY_CLIENT_SECRET=REPLACE_ME_SECONDARY_AZURE_CLIENT_SECRET
