# =============================================================================
# Next.js app (apps/frontend/.env.local)
# Copy to .env.local and fill in. Placeholders only — never commit real values.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- WorkOS AuthKit ----------------------------------------------------------
# WorkOS dashboard -> API Keys. `convex dev` can also auto-provision these
# (see convex.json "authKit") and write them here.
WORKOS_CLIENT_ID=client_REPLACE_ME
WORKOS_API_KEY=sk_test_REPLACE_ME
# Any random string of at least 32 characters (encrypts the session cookie).
WORKOS_COOKIE_PASSWORD=REPLACE_ME_AT_LEAST_32_CHARACTERS_LONG
# Must also be registered as a Redirect URI in WorkOS.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Convex ------------------------------------------------------------------
# Written automatically by `pnpm --filter frontend exec convex dev` on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Shared secret for server-to-server Convex calls (Next API routes -> Convex
# functions guarded by requireServerSecret). Must be IDENTICAL in the Convex
# deployment: npx convex env set CONVEX_SERVER_SECRET <value>
CONVEX_SERVER_SECRET=REPLACE_ME_CONVEX_SERVER_SECRET

# --- NestJS backend ----------------------------------------------------------
# Defaults to http://localhost:8000 in development; required in production.
BACKEND_URL=http://localhost:8000
# Server-only key for the "Crear en ERP" route (app/api/erp/terceros -> Nest). Must match
# NEST_INTERNAL_KEY in apps/backend/.env. Required only for that button.
NEST_INTERNAL_KEY=REPLACE_ME_NEST_INTERNAL_KEY

# --- App ---------------------------------------------------------------------
# Public base URL, used for links inside emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HMAC key for the admin impersonation cookie. Required and dedicated
# (never reuse another secret).
IMPERSONATE_COOKIE_SECRET=REPLACE_ME_IMPERSONATE_COOKIE_SECRET

# --- Email notifications (Resend) -------------------------------------------
# Optional: without RESEND_API_KEY the notification routes skip sending.
RESEND_API_KEY=re_REPLACE_ME
# Sender, e.g. "Notifications <notifications@example.com>" (verified domain in Resend).
RESEND_FROM_EMAIL="Notifications <notifications@example.com>"
# Header secret Convex sends to /api/notifications/{billing,advances,onboarding/*}.
# Must match the Convex env var of the same name.
NOTIFICATIONS_INTERNAL_KEY=REPLACE_ME_NOTIFICATIONS_INTERNAL_KEY
# HMAC secret for /api/notifications/billing/{sla-digest,sync-alerta}.
# Must match the Convex env var of the same name.
FACTURACION_SLA_DIGEST_SECRET=REPLACE_ME_FACTURACION_SLA_DIGEST_SECRET
# Svix signing secret of the Resend webhook that points to /api/webhooks/resend/onboarding
# (delivery tracking of supplier/customer onboarding emails). Optional.
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Onboarding (suppliers / customers) --------------------------------------
# Optional: OpenRouter key for the AI extraction of RUT fields in "Iniciar proceso".
# Without it the modal falls back to manual entry.
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Convex deployment variables are NOT read from this file.
# See convex/.env.convex.example and set them with `npx convex env set`.
