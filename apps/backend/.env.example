# =============================================================================
# NestJS backend (apps/backend/.env)
# Copy to .env and fill in. Placeholders only — never commit real values.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Database (Postgres; Neon or any other) ----------------------------------
# Pooled connection used at runtime. Required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by Prisma migrations. Optional.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- WorkOS (verifies access tokens, looks up users) --------------------------
# Same values as the Next app. Required.
WORKOS_CLIENT_ID="client_REPLACE_ME"
WORKOS_API_KEY="sk_test_REPLACE_ME"

# --- Internal auth -----------------------------------------------------------
# x-internal-key for server-to-server calls from the Next.js BFF ("Crear en ERP" in the last
# onboarding phase). Must match NEST_INTERNAL_KEY in apps/frontend/.env.local. Required.
NEST_INTERNAL_KEY=REPLACE_ME_NEST_INTERNAL_KEY

# --- ERP (SIESA) --------------------------------------------------------------
# Where the clientes/proveedores catalog comes from. Locally this is the ERP simulator
# (apps/erp-simulator); for the real SIESA Cloud use https://servicios.siesacloud.com and
# its credentials. Leave the three unset to run without an ERP: the catalog stays readable
# but nothing syncs.
ERP_BASE_URL="http://localhost:8100"
# Must match ERP_SIM_CONNI_KEY / ERP_SIM_CONNI_TOKEN in apps/erp-simulator/.env.
ERP_CONNI_KEY=REPLACE_ME_CONNI_KEY
ERP_CONNI_TOKEN=REPLACE_ME_CONNI_TOKEN
# SIESA instance (idCompania) of each group of companies; defaults match the simulator.
# ERP_INSTANCIA_1_ID_COMPANIA="5001"
# ERP_INSTANCIA_2_ID_COMPANIA="5002"
# Optional tuning: request timeout (ms) and rows per page.
# ERP_TIMEOUT_MS="30000"
# ERP_TAM_PAGINA="500"
# Daily catalog sync inside the backend (cron with seconds, Bogotá time). "false" disables it.
ERP_SYNC_PROGRAMADA="true"
# ERP_SYNC_CRON="0 0 2 * * *"
# ERP_SYNC_TZ="America/Bogota"

# --- Server ------------------------------------------------------------------
# Allowed CORS origin.
FRONTEND_URL="http://localhost:3000"
BACKEND_PORT="8000"
# Swagger (/api) is served when NODE_ENV != "production" or ENABLE_SWAGGER="true".
NODE_ENV="development"
ENABLE_SWAGGER="false"
