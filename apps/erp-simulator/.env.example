# =============================================================================
# ERP simulator (apps/erp-simulator/.env)
# A fake SIESA with its OWN Postgres database, separate from the app database.
# Copy to .env and fill in. Placeholders only — never commit real values.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Database (its own Postgres: e.g. a second database in your Neon project) -
# Pooled connection used at runtime. Required. Never point this at the app DB.
ERP_SIM_DATABASE_URL="postgresql://USER:PASSWORD@HOST/erp_sim?sslmode=require"
# Direct (non-pooled) connection used by Prisma migrate/seed. Optional.
ERP_SIM_DIRECT_URL="postgresql://USER:PASSWORD@HOST/erp_sim?sslmode=require"

# --- SIESA-style credentials (ConniKey / ConniToken headers) -----------------
# The backend sends them as ERP_CONNI_KEY / ERP_CONNI_TOKEN; values must match. Required.
ERP_SIM_CONNI_KEY=REPLACE_ME_CONNI_KEY
ERP_SIM_CONNI_TOKEN=REPLACE_ME_CONNI_TOKEN

# --- Server ------------------------------------------------------------------
ERP_SIM_PORT="8100"
# Swagger (/docs) is served when NODE_ENV != "production" or ENABLE_SWAGGER="true".
NODE_ENV="development"
ENABLE_SWAGGER="false"
